generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users, roles & accreditation
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  phone              String?   @unique
  email              String?   @unique
  name               String?
  passwordHash       String?
  role               String    @default("STUDENT") // STUDENT | TEACHER | SCHOOL_ADMIN | ADMIN | SUPER_ADMIN | PARENT
  profileComplete    Boolean   @default(true)
  classGradeId       String?
  classGrade         ClassGrade? @relation(fields: [classGradeId], references: [id], onDelete: SetNull)
  school             String?
  district           String?
  emisSchoolId       String?
  sex                String?
  dateOfBirth        DateTime?
  guardianName       String?
  guardianPhone      String?
  avatarSeed         String?
  image              String?
  studentNumber      String?   @unique
  schoolId           String?
  schoolMember       School?   @relation("SchoolMember", fields: [schoolId], references: [id], onDelete: SetNull)
  ownedSchool        School?   @relation("SchoolOwner")

  // Monetisation
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  // Engagement
  xp                 Int       @default(0)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActiveOn       DateTime?
  accountKind        String    @default("REAL") // REAL | DEMO | TEST

  freeSubjectClaims  FreeSubjectClaim[]
  subscriptionPayments SubscriptionPayment[]
  storeOrders        StoreOrder[]
  attempts           Attempt[]
  teacherProfile     TeacherProfile?
  markedAnswers      Answer[]  @relation("MarkedBy")
  authoredNotes      Note[]    @relation("NoteAuthor")
  authoredPapers     Paper[]   @relation("PaperAuthor")
  reviewedTeachers   TeacherProfile[] @relation("TeacherReviewer")
  feedback           Feedback[]
  syncLogs           SyncLog[]
  classroomsTaught   Classroom[]  @relation("ClassroomTeacher")
  enrollments        Enrollment[]
  feeCharges         FeeCharge[]
  feePayments        FeePayment[]
  attendance         AttendanceMark[] @relation("StudentAttendance")
  attendanceTaken    AttendanceMark[] @relation("TeacherAttendance")
  messagesSent       SchoolMessage[]  @relation("MessageFrom")
  messagesReceived   SchoolMessage[]  @relation("MessageTo")
  payments           PaymentTransaction[]
  markOverrides      MarkOverride[] @relation("MarkOverrides")
  digitizationJobs   DigitizationJob[] @relation("DigitizationAuthor")
  digitizationReviews DigitizationJob[] @relation("DigitizationReviewer")
  mobileSessions     MobileSession[]
  entitlements       Entitlement[]
  freeExamGrants     FreeExamGrant[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([classGradeId])
  @@index([schoolId])
  @@index([role])
}

model TeacherProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  registrationNumber String    @unique // MoES / UTS teacher registration number
  nationalId         String?
  school             String
  district           String
  qualification      String    // Grade III | Grade V | Bachelor's | Master's | Other
  yearsExperience    Int       @default(0)
  subjects           String    @default("[]") // JSON string[] of subject names
  classes            String    @default("[]") // JSON string[] of class slugs
  bio                String?
  status             String    @default("PENDING") // PENDING | ACCREDITED | REJECTED | SUSPENDED
  reviewedById       String?
  reviewedBy         User?     @relation("TeacherReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Curriculum hierarchy: Level → ClassGrade → Subject → Topic
// ─────────────────────────────────────────────────────────────────────────────

model Level {
  id          String       @id @default(cuid())
  slug        String       @unique // pre-primary | primary | o-level | a-level | university
  name        String       @unique
  order       Int          @default(0)
  description String?
  classGrades ClassGrade[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ClassGrade {
  id              String   @id @default(cuid())
  slug            String   @unique // baby | middle | top | p1..p7 | s1..s6 | university
  name            String   // "Primary Four"
  shortName       String   // "P.4"
  levelId         String
  level           Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  order           Int      @default(0)
  phase           String?  // "Transition year"
  description     String?
  color           String   @default("#10b981")
  freshTeacherKey String?  // "PrimaryFour"
  isActive        Boolean  @default(true)

  subjects   Subject[]
  students   User[]
  papers     Paper[]
  resources  ExternalResource[]
  classrooms Classroom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([levelId])
  @@index([isActive])
}

model Subject {
  id              String     @id @default(cuid())
  slug            String
  name            String
  classGradeId    String
  classGrade      ClassGrade @relation(fields: [classGradeId], references: [id], onDelete: Cascade)
  color           String     @default("#0ea5e9")
  icon            String     @default("book")
  order           Int        @default(0)
  description     String?
  freshTeacherKey String?    // "MTC", "Science", "SST" ...
  isExaminable    Boolean    @default(true)

  topics     Topic[]
  papers     Paper[]
  freeSubjectClaims FreeSubjectClaim[]
  notes      Note[]
  resources  ExternalResource[]
  classrooms Classroom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, classGradeId])
  @@index([classGradeId])
}

model Topic {
  id        String   @id @default(cuid())
  slug      String
  name      String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term      Int?     // 1 | 2 | 3
  order     Int      @default(0)
  summary   String?

  notes     Note[]
  papers    Paper[]
  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, subjectId])
  @@index([subjectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Learning content
// ─────────────────────────────────────────────────────────────────────────────

model Note {
  id             String   @id @default(cuid())
  slug           String
  title          String
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId        String?
  topic          Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  summary        String?
  content        String   // Markdown
  readingMinutes Int      @default(5)
  order          Int      @default(0)
  sourceType     String   @default("LOCAL") // LOCAL | FRESH_TEACHER | UPLOAD
  sourceUrl      String?
  pdfUrl         String?
  attribution    String?
  status         String   @default("PUBLISHED") // DRAFT | PUBLISHED
  authorId       String?
  author         User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, subjectId])
  @@index([subjectId, status])
  @@index([topicId])
}

model Paper {
  id              String     @id @default(cuid())
  title           String
  description     String?
  kind            String     @default("PAST_PAPER") // PAST_PAPER | TOPIC_QUIZ | PRACTICE_SET | HOLIDAY_PACKAGE | MOCK
  year            Int?
  term            Int?
  examBody        String?    // UNEB, school name, etc.
  subjectId       String
  subject         Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classGradeId    String?
  classGrade      ClassGrade? @relation(fields: [classGradeId], references: [id], onDelete: SetNull)
  topicId         String?
  topic           Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  pdfUrl          String?
  sourceUrl       String?
  sourceType      String     @default("LOCAL") // LOCAL | FRESH_TEACHER | UPLOAD | LEGACY_OCR
  attribution     String?
  externalId      String?    @unique
  status          String     @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  durationMinutes Int?
  difficulty      String?    // EASY | MEDIUM | HARD
  authorId        String?
  author          User?      @relation("PaperAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  questions Question[]
  attempts  Attempt[]
  resources ExternalResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, status])
  @@index([classGradeId])
  @@index([topicId])
}

model Question {
  id               String   @id @default(cuid())
  paperId          String
  paper            Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  topicId          String?
  topic            Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  type             String   // MULTIPLE_CHOICE | MULTI_SELECT | FILL_BLANK | SHORT_ANSWER | NUMERIC | CALCULATION | TRUE_FALSE | MATCHING | ORDERING | DIAGRAM_LABEL | COMPREHENSION | LONG_ANSWER | DRAWING
  displayNumber    String?
  section          String?
  stimulus         String?  // Passage / instruction shared with the question (markdown)
  imageUrl         String?
  prompt           String
  options          String?  // JSON string[]
  correctAnswer    String   // JSON (string | string[] | number | pairs)
  acceptedAnswers  String?  // JSON string[] alternative accepted spellings
  explanation      String?
  markingGuide     String?  // Rubric / keywords for teacher & AI
  numericTolerance Float?
  caseSensitive    Boolean  @default(false)
  requiresTeacher  Boolean  @default(false)
  points           Float    @default(1)
  order            Int
  parentId         String?
  parent           Question?  @relation("QuestionParts", fields: [parentId], references: [id], onDelete: SetNull)
  parts            Question[] @relation("QuestionParts")
  unit             String?
  partialRule      String?  // all-or-nothing | proportional | proportional-penalty | position | value-half

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paperId])
  @@index([topicId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Attempts & marking
// ─────────────────────────────────────────────────────────────────────────────

model Attempt {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId          String
  paper            Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  mode             String    @default("PRACTICE") // PRACTICE | EXAM
  status           String    @default("SUBMITTED") // IN_PROGRESS | SUBMITTED | NEEDS_REVIEW | GRADED
  score            Float     @default(0)
  maxScore         Float     @default(0)
  pendingCount     Int       @default(0)
  timeSpentSeconds Int?
  startedAt        DateTime  @default(now())
  deadlineAt       DateTime?
  completedAt      DateTime?
  finalizedAt      DateTime?
  gradedAt         DateTime?
  markingVersion   Int       @default(1)

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, completedAt])
  @@index([userId, status])
  @@index([userId, paperId, status])
  @@index([paperId])
}

model Answer {
  id            String   @id @default(cuid())
  attemptId     String
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  studentAnswer String?  // Raw text / JSON / data-url for drawings
  version       Int      @default(1)
  isCorrect     Boolean?
  pointsAwarded Float?
  gradingStatus String   @default("PENDING_TEACHER") // UNANSWERED | AUTO | AI | PENDING_TEACHER | TEACHER_MARKED
  feedback      String?  // Shown to the student
  teacherNote   String?
  markedById    String?
  markedBy      User?    @relation("MarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt      DateTime?
  overrides     MarkOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([gradingStatus])
}

model MarkOverride {
  id             String   @id @default(cuid())
  answerId       String
  answer         Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User     @relation("MarkOverrides", fields: [actorId], references: [id], onDelete: Cascade)
  previousPoints Float?
  points         Float
  reason         String
  createdAt      DateTime @default(now())

  @@index([answerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// External content (Fresh Teacher library) & operations
// ─────────────────────────────────────────────────────────────────────────────

model ExternalResource {
  id             String      @id @default(cuid())
  source         String      @default("FRESH_TEACHER")
  kind           String      // PAST_PAPER | LESSON_NOTES | SCHEME_OF_WORK | HOLIDAY_PACKAGE
  feed           String      // e.g. PrimarySevenSciencePastPapers
  classGradeId   String?
  classGrade     ClassGrade? @relation(fields: [classGradeId], references: [id], onDelete: SetNull)
  subjectId      String?
  subject        Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectKey     String?
  title          String
  description    String?
  pdfUrl         String      @unique
  year           Int?
  term           Int?
  status         String      @default("LISTED") // LISTED | IMPORTED | HIDDEN | BROKEN
  importedPaperId String?
  importedPaper  Paper?      @relation(fields: [importedPaperId], references: [id], onDelete: SetNull)
  firstSeenAt    DateTime    @default(now())
  lastSeenAt     DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([classGradeId])
  @@index([subjectId])
}

model SyncLog {
  id          String   @id @default(cuid())
  source      String   @default("FRESH_TEACHER")
  feed        String
  itemCount   Int      @default(0)
  newCount    Int      @default(0)
  status      String   @default("OK") // OK | ERROR | EMPTY
  message     String?
  triggeredById String?
  triggeredBy User?    @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Classroom {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  teacherId   String
  teacher     User       @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  classGradeId String
  classGrade  ClassGrade @relation(fields: [classGradeId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([teacherId])
  @@index([classGradeId])
}

model Enrollment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([classroomId, userId])
  @@index([userId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  district  String?
  ownerId   String   @unique
  owner     User     @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   User[]   @relation("SchoolMember")
  charges   FeeCharge[]
  payments  FeePayment[]
  attendance AttendanceMark[]
  messages  SchoolMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeCharge {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  amount    Int
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}

model FeePayment {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}

model AttendanceMark {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("StudentAttendance", fields: [userId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherAttendance", fields: [teacherId], references: [id], onDelete: Cascade)
  day       String
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([schoolId, day])
}

model SchoolMessage {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fromId    String
  from      User     @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([toId])
  @@index([fromId])
}

model Feedback {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category   String   // CONTESTED_ANSWER | CONTENT_ISSUE | FEATURE_REQUEST | GENERAL
  message    String
  paperId    String?
  questionId String?
  status     String   @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model DigitizationJob {
  id              String   @id @default(cuid())
  createdById     String
  createdBy       User     @relation("DigitizationAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  status          String   @default("QUEUED") // QUEUED | PROCESSING | AWAITING_REVIEW | NEEDS_CORRECTION | APPROVED | PUBLISHED | REJECTED | FAILED | CANCELLED
  progress        Int      @default(0)
  stage           String   @default("queued")
  sourceHash      String
  sourceKind      String
  fileName        String
  mime            String
  byteSize        Int
  subjectId       String?
  title           String?
  year            Int?
  attempts        Int      @default(0)
  maxAttempts     Int      @default(2)
  model           String   @default("gemini-2.5-flash")
  tokensUsed      Int      @default(0)
  errorClass      String?
  errorMessage    String?
  confidence      Float?
  draft           String?
  paperId         String?
  reviewerId      String?
  reviewer        User?    @relation("DigitizationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  cancelRequested Boolean  @default(false)
  importedSource  DigitizationSource?
  events          DigitizationEvent[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdById, createdAt])
  @@index([status])
  @@index([sourceHash])
}

model DigitizationSource {
  jobId       String          @id
  job         DigitizationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  gitBlob     String          @unique
  url         String
  permission  String?
  bytes       Bytes
}

model DigitizationEvent {
  id        String          @id @default(cuid())
  jobId     String
  job       DigitizationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage     String
  message   String
  actorId   String?
  createdAt DateTime        @default(now())

  @@index([jobId])
}

model MobileSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Plan {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  kind           String  // DIGITAL | PHYSICAL
  price          Int
  currency       String  @default("UGX")
  periodDays     Int?
  playProductId  String?
  appleProductId String?
  active         Boolean @default(true)
  grantsAccess   Boolean @default(false)

  @@index([kind, active])
}

model Entitlement {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode    String
  source      String    // YO | PLAY | APPLE | GRANT | SCHOOL | SCHOLARSHIP
  providerRef String    @unique
  startsAt    DateTime
  endsAt      DateTime
  revokedAt   DateTime?
  graceHours  Int       @default(24)
  createdAt   DateTime  @default(now())

  @@index([userId, endsAt])
}

model FreeExamGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  attemptId String   @unique
  createdAt DateTime @default(now())

  @@unique([userId, subjectId])
}

model BillingEvent {
  id          String   @id @default(cuid())
  source      String
  providerRef String
  status      String
  createdAt   DateTime @default(now())

  @@unique([source, providerRef, status])
}

// Permanent one-free-completed-practice entitlement per user and subject.
// Unique index ensures two concurrent submissions cannot both consume the free allowance.
model FreeSubjectClaim {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  attemptId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, subjectId])
  @@index([subjectId])
}

// A real provider transaction is required before granting Pro.
model SubscriptionPayment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   @default("STUDENT_YEARLY")
  amountUgx         Int
  customerMsisdn    String
  externalReference String   @unique
  providerReference String?  @unique
  status            String   @default("CREATED") // CREATED | PENDING | SUCCEEDED | FAILED | REVIEW
  verifiedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([userId, createdAt])
}

// SchoolQuest physical goods catalogue. No digital textbooks may be offered here
// without separate licensing and app-store payment policy review.
model StoreProduct {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  description       String?
  category          String   // TABLET | TSHIRT | TEXTBOOK
  priceUgx          Int
  stockQuantity     Int      @default(0)
  imageUrl          String?
  audience          String?
  publisher         String?
  isbn              String?
  rightsConfirmed   Boolean  @default(false)
  isPhysical        Boolean  @default(true)
  bundleMonth       Boolean  @default(false)
  status            String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  orderLines        StoreOrderLine[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, category])
}

model StoreOrder {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerName      String
  contactPhone      String
  deliveryLocation  String
  totalUgx          Int
  status            String   @default("REQUESTED") // REQUESTED | CONFIRMED | PAID | FULFILLED | CANCELLED
  paymentReference  String?
  paymentVerifiedAt DateTime?
  verifiedByUserId  String?
  fulfilledAt       DateTime?
  lines             StoreOrderLine[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model StoreOrderLine {
  id              String @id @default(cuid())
  orderId         String
  order           StoreOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId       String
  product         StoreProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  unitPriceUgx    Int
  bundleMonth     Boolean @default(false)
  @@index([productId])
}

// Single non-recurring, 30-day trial linked to one physically fulfilled tablet.
// Not an automatically recurring paid subscription. Subject to store policy review.
model StoreBundleGrant {
  id           String   @id @default(cuid())
  orderId      String   @unique
  userId       String
  grantedAt    DateTime @default(now())
  expiresAt    DateTime
  notes        String?
  @@index([userId, expiresAt])
}

model PaymentTransaction {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode       String
  amount         Int
  currency       String    @default("UGX")
  status         String    @default("PENDING") // PENDING | FAILED | VERIFIED | REFUNDED
  provider       String?
  providerRef    String?   @unique
  kind           String    @default("DIGITAL") // DIGITAL | PHYSICAL
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  verifiedAt     DateTime?

  @@index([userId, status])
}
